              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"firebase_token\": \"test-fcm-token-from-postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Sends firebase_token exactly like the Flutter client does; the API stores it on the user for push notifications. Logging in deletes all previous tokens, so any other signed-in device is kicked out."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
