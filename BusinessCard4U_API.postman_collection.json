              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "verify-otp"
              ]
            }
          }
        },
        {
          "name": "Complete Register",
